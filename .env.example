# EventSpace — variables d'environnement
# Copier ce fichier en `.env` (ignoré par git) et renseigner les valeurs.
# Ces clés sont des clés PUBLIQUES (anon / publishable) mais ne doivent
# pas être versionnées dans le dépôt.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
